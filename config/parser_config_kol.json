{
  "_comment": "KOL 数据播报解析规则",
  "strategy": "regex",
  "field_labels": {
    "timestamp":          "日期",
    "kol_visitors":       "KOL 链接访问用户数",
    "kol_visitors_today": "KOL 链接今日访问用户数",
    "kol_twitter":        "KOL 渠道细分twitter",
    "kol_not_set":        "KOL 渠道细分not set",
    "kol_tco":            "KOL 渠道细分t.co",
    "kol_reg_total":      "KOL 注册用户数",
    "kol_reg_4h":         "KOL 注册用户数近4小时新增",
    "kol_deposit":        "KOL 入金总量",
    "kol_address_users":  "AD 有地址用户数"
  },
  "fields": [
    {
      "name": "timestamp",
      "pattern": ""
    },
    {
      "name": "kol_visitors",
      "_comment": "KOL 链接访问用户数：5（今日 5）",
      "pattern": "KOL 链接访问用户数[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": true,
      "default": ""
    },
    {
      "name": "kol_visitors_today",
      "pattern": "KOL 链接访问用户数[：:][^（]*（今日\\s*([\\d,]+)）",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_twitter",
      "pattern": "twitter\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_not_set",
      "pattern": "\\(not set\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_tco",
      "pattern": "t\\.co\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_reg_total",
      "pattern": "总计\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_reg_4h",
      "pattern": "近4小时新增\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_deposit",
      "pattern": "KOL 入金总量[：:]\\s*([\\d,.]+)\\s*USDT",
      "group": 1,
      "type": "float",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_address_users",
      "pattern": "KOL 有地址用户数[：:]\\s*(\\d+)\\s*/",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    }
  ],
  "row_order": [
    "timestamp",
    "kol_visitors",
    "kol_visitors_today",
    "kol_twitter",
    "kol_not_set",
    "kol_tco",
    "kol_reg_total",
    "kol_reg_4h",
    "kol_deposit",
    "kol_address_users"
  ]
}
