{
  "_comment": "Other数据播报解析规则",
  "strategy": "regex",
  "field_labels": {
    "timestamp":          "日期",
    "kol_visitors":       "Other 链接访问用户数",
    "kol_visitors_today": "Other 链接今日访问用户数",
    "kol_twitter":        "Other渠道细分twitter",
    "kol_not_set":        "Other渠道细分not set",
    "kol_direct":         "Other 渠道细分direct",
    "kol_tco":            "Other渠道细分t.co",
    "kol_web_telegram":   "Other 渠道细分web.telegram.org",
    "kol_reg_total":      "Other注册用户数",
    "kol_reg_4h":         "Other注册用户数近4小时新增",
    "kol_deposit":        "Other 入金总量",
    "kol_address_users":  "Other 有地址用户数"
  },
  "fields": [
    {
      "name": "timestamp",
      "pattern": ""
    },
    {
      "name": "kol_visitors",
      "_comment": "Other 链接访问用户数：5（今日 5）",
      "pattern": "Other 链接访问用户数[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": true,
      "default": ""
    },
    {
      "name": "kol_visitors_today",
      "pattern": "Other 链接访问用户数[：:][^（]*（今日\\s*([\\d,]+)）",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_twitter",
      "pattern": "twitter\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_not_set",
      "pattern": "\\(not set\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_direct",
      "pattern": "\\(direct\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_tco",
      "pattern": "t\\.co\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_web_telegram",
      "pattern": "web\\.telegram\\.org\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_reg_total",
      "pattern": "总计\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_reg_4h",
      "pattern": "近4小时新增\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_deposit",
      "pattern": "Other 入金总量[：:]\\s*([\\d,.]+)\\s*USDT",
      "group": 1,
      "type": "float",
      "required": false,
      "default": 0
    },
    {
      "name": "kol_address_users",
      "pattern": "Other 有地址用户数[：:]\\s*(\\d+)\\s*/",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    }
  ],
  "row_order": [
    "timestamp",
    "kol_visitors",
    "kol_visitors_today",
    "kol_twitter",
    "kol_not_set",
    "kol_direct",
    "kol_tco",
    "kol_web_telegram",
    "kol_reg_total",
    "kol_reg_4h",
    "kol_deposit",
    "kol_address_users"
  ]
}
