    "deposit_total": "伞下入金数量总量",
    "address_today": "伞下地址数量今日新增",
    "address_total": "伞下地址数量总计"
  },
  "fields": [
    {
      "name": "report_date",
      "pattern": "统计时间[：:]\\s*GMT\\+08:00\\s*(\\d{4}-\\d{2}-\\d{2})",
      "group": 1,
      "type": "date_ms",
      "required": true
    },
    {
      "name": "channel_visitors_today",
      "pattern": "今日渠道访问用户数[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": true,
      "default": ""
    },
    {
      "name": "channel_visitors_total",
      "pattern": "今日渠道访问用户数[：:][^（(]*[（(]\\s*累计\\s*([\\d,]+)\\s*[）)]",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "new_users_today",
      "pattern": "今日新用户\\s*/\\s*总用户量[：:]\\s*([\\d,]+)\\s*/",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "total_users",
      "pattern": "今日新用户\\s*/\\s*总用户量[：:]\\s*[\\d,]+\\s*/\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "task_users_today",
      "pattern": "今日完成任务的用户[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "active_users_today",
      "pattern": "今日活跃用户[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "task_new_common_1",
      "pattern": "今日每阶段任务完成数新增[：:][\\s\\S]*?\\[通用版\\][^\\n]*?[|\\s]1:\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
