{
  "_comment": "AD 数据播报解析规则",
  "strategy": "regex",
  "field_labels": {
    "timestamp":          "日期",
    "ad_visitors":        "X 链接访问用户数",
    "ad_visitors_today":  "X 链接今日访问用户数",
    "ad_fb":              "X 渠道细分fb",
    "ad_not_set":         "X 渠道细分Not Set",
    "ad_twitter":         "X 渠道细分twitter",
    "ad_facebook_com":    "X 渠道细分facebook.com",
    "ad_mfacebook":       "X 渠道细分m.facebook.com",
    "ad_reg_total":       "X 注册用户数",
    "ad_reg_4h":          "X 注册用户数近4小时新增",
    "ad_deposit":         "X 入金总量",
    "ad_address_users":   "X 有地址用户数"
  },
  "fields": [
    {
      "name": "timestamp",
      "pattern": ""
    },
    {
      "name": "ad_visitors",
      "_comment": "X 链接访问用户数：19（今日 19）",
      "pattern": "X 链接访问用户数[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": true,
      "default": ""
    },
    {
      "name": "ad_visitors_today",
      "pattern": "X 链接访问用户数[：:][^（]*（今日\\s*([\\d,]+)）",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_fb",
      "pattern": "\\bfb\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_not_set",
      "pattern": "\\(not set\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_twitter",
      "pattern": "twitter\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_facebook_com",
      "_comment": "用竖线定位，避免匹配 m.facebook.com",
      "pattern": "\\|\\s*facebook\\.com\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_mfacebook",
      "pattern": "m\\.facebook\\.com\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_reg_total",
      "pattern": "总计\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_reg_4h",
      "pattern": "近4小时新增\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_deposit",
      "pattern": "X 入金总量[：:]\\s*([\\d,.]+)\\s*USDT",
      "group": 1,
      "type": "float",
      "required": false,
      "default": 0
    },
    {
      "name": "ad_address_users",
      "pattern": "X 有地址用户数[：:]\\s*([\\d,]+)\\s*/",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    }
  ],
  "row_order": [
    "timestamp",
    "ad_visitors",
    "ad_visitors_today",
    "ad_fb",
    "ad_not_set",
    "ad_twitter",
    "ad_facebook_com",
    "ad_mfacebook",
    "ad_reg_total",
    "ad_reg_4h",
    "ad_deposit",
    "ad_address_users"
  ]
}
