{
  "_comment": "BTG VN 数据播报解析规则",
  "strategy": "regex",
  "field_labels": {
    "timestamp":                  "日期",
    "btgvn_visitors":             "BTG VN链接访问用户数",
    "btgvn_tiktok":               "BTG VN渠道细分tiktok",
    "btgvn_fb":                   "BTG VN渠道细分fb",
    "btgvn_not_set":              "BTG VN渠道细分not set",
    "btgvn_twitter":              "BTG VN渠道细分twitter",
    "btgvn_direct":               "BTG VN渠道细分direct",
    "btgvn_mfacebook":            "BTG VN渠道细分m.facebook.com",
    "btgvn_data_not_available":   "BTG VN渠道细分data not available",
    "btgvn_an":                   "BTG VN渠道细分an",
    "btgvn_ig":                   "BTG VN渠道细分ig",
    "btgvn_zalo":                 "BTG VN渠道细分zalo",
    "btgvn_facebook_com":         "BTG VN渠道细分facebook.com",
    "btgvn_google":               "BTG VN渠道细分google",
    "btgvn_reg_total":            "BTG VN注册用户数总计",
    "btgvn_reg_24h":              "BTG VN注册用户数近24小时新增",
    "btgvn_deposit":              "BTG VN入金总量",
    "btgvn_address_users":        "BTG VN有地址用户数"
  },
  "fields": [
    {
      "name": "timestamp",
      "pattern": ""
    },
    {
      "name": "btgvn_visitors",
      "pattern": "BTG VN 链接访问用户数[：:]\\s*([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": true,
      "default": ""
    },
    {
      "name": "btgvn_tiktok",
      "pattern": "tiktok\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_fb",
      "pattern": "\\bfb\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_not_set",
      "pattern": "\\(not set\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_twitter",
      "pattern": "twitter\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_direct",
      "pattern": "\\(direct\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_mfacebook",
      "pattern": "m\\.facebook\\.com\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_data_not_available",
      "pattern": "\\(data not available\\)\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_an",
      "pattern": "\\|\\s*an\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_ig",
      "pattern": "\\|\\s*ig\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_zalo",
      "pattern": "zalo\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_facebook_com",
      "_comment": "用竖线定位，避免匹配 m.facebook.com",
      "pattern": "\\|\\s*facebook\\.com\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_google",
      "pattern": "\\|\\s*google\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_reg_total",
      "pattern": "总计\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_reg_24h",
      "pattern": "近24小时新增\\s+([\\d,]+)",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_deposit",
      "pattern": "BTG VN 入金总量[：:]\\s*([\\d,.]+)\\s*USDT",
      "group": 1,
      "type": "float",
      "required": false,
      "default": 0
    },
    {
      "name": "btgvn_address_users",
      "pattern": "BTG VN 有地址用户数[：:]\\s*(\\d+)\\s*/",
      "group": 1,
      "type": "int",
      "required": false,
      "default": 0
    }
  ],
  "row_order": [
    "timestamp",
    "btgvn_visitors",
    "btgvn_tiktok",
    "btgvn_fb",
    "btgvn_not_set",
    "btgvn_twitter",
    "btgvn_direct",
    "btgvn_mfacebook",
    "btgvn_data_not_available",
    "btgvn_an",
    "btgvn_ig",
    "btgvn_zalo",
    "btgvn_facebook_com",
    "btgvn_google",
    "btgvn_reg_total",
    "btgvn_reg_24h",
    "btgvn_deposit",
    "btgvn_address_users"
  ]
}
